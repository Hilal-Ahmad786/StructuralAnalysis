# =============================================================================
# Supabase Configuration
# =============================================================================
# Get these from your Supabase project settings: Settings > API

# Public URL (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon key (safe to expose in browser - used with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (NEVER expose in browser - bypasses RLS)
# Only used in server components/API routes
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# Application Configuration
# =============================================================================

# Base URL for the application (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Optional: Analytics / Monitoring
# =============================================================================

# Sentry DSN (optional, for error tracking)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
